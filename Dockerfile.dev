FROM mcr.microsoft.com/dotnet/sdk:8.0 AS dev
WORKDIR /app

# Copiar el csproj y restaurar dependencias
COPY ["SmartParkingBackend.csproj", "./"]
RUN dotnet restore "SmartParkingBackend.csproj"

# Copiar todo el resto del código
COPY . .

# Instalar dotnet-watch para hot-reload
RUN dotnet tool install --global dotnet-watch

# Variables de entorno para desarrollo
ENV ASPNETCORE_ENVIRONMENT=Development
ENV ASPNETCORE_URLS=http://+:8080;https://+:8081
ENV DOTNET_USE_POLLING_FILE_WATCHER=1

# Exponer puertos
EXPOSE 8080
EXPOSE 8081

# El entrypoint usa dotnet watch para hot-reload
ENTRYPOINT ["dotnet", "watch", "run", "--no-restore", "--urls", "http://+:8080;https://+:8081"] 